rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The dashboard is deliberately tied to one verified Firebase account.
    // Do not replace this with a value sent by the browser.
    function isEmailCustomer() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A guest checkout receives a temporary Firebase Anonymous UID. It can
    // create one validated order, but never read orders or access the panel.
    function isAnonymousOrderSession() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function canCreateOrder() {
      return isEmailCustomer() || isAnonymousOrderSession();
    }

    function isAdmin() {
      return isEmailCustomer()
        && request.auth.token.email == 'dudumesquita2004@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasAllowedFields(data, required, optional) {
      return data is map
        && data.keys().hasAll(required)
        && data.keys().hasOnly(required.concat(optional));
    }

    function stringBetween(value, minLength, maxLength) {
      return value is string
        && value.size() >= minLength
        && value.size() <= maxLength;
    }

    function validCustomer(customer) {
      return hasAllowedFields(customer, ['name', 'phone'], [])
        && stringBetween(customer.name, 2, 80)
        && stringBetween(customer.phone, 10, 20);
    }

    function validDelivery(delivery) {
      return hasAllowedFields(
          delivery,
          ['zipCode', 'street', 'number', 'neighborhood'],
          ['complement']
        )
        && delivery.zipCode is string
        && delivery.zipCode.matches('^[0-9]{8}$')
        && stringBetween(delivery.street, 3, 120)
        && stringBetween(delivery.number, 1, 20)
        && stringBetween(delivery.neighborhood, 2, 80)
        && (!('complement' in delivery)
          || stringBetween(delivery.complement, 0, 120));
    }

    function validOrderIdentity(order) {
      return order.customerUid is string
        && order.customerUid == request.auth.uid
        && order.customerEmail is string
        && ((isAnonymousOrderSession() && order.customerEmail == '')
          || (isEmailCustomer()
            && order.customerEmail == request.auth.token.email));
    }

    function validFulfillment(order) {
      return (order.fulfillmentMethod == 'delivery'
          && ('delivery' in order)
          && validDelivery(order.delivery)
          && order.deliveryFeeCents == 800)
        || (order.fulfillmentMethod == 'pickup'
          && !('delivery' in order)
          && order.deliveryFeeCents == 0);
    }

    function validFlavorId(flavorId) {
      return flavorId is string
        && flavorId in [
          'mussarela', 'calabresa', 'marguerita', 'portuguesa', 'frango',
          'lavras', 'lombo', 'quatro', 'rucula', 'romeu', 'chocolate', 'banana'
        ];
    }

    function priceFor(flavorId, size) {
      let brotoPrices = {
        'mussarela': 2800, 'calabresa': 3000, 'marguerita': 3100,
        'portuguesa': 3200, 'frango': 3400, 'lavras': 3300,
        'lombo': 3400, 'quatro': 3500, 'rucula': 3500,
        'romeu': 3200, 'chocolate': 3300, 'banana': 3200
      };
      let mediumPrices = {
        'mussarela': 3800, 'calabresa': 4100, 'marguerita': 4200,
        'portuguesa': 4500, 'frango': 4300, 'lavras': 4400,
        'lombo': 4500, 'quatro': 4500, 'rucula': 4400,
        'romeu': 4300, 'chocolate': 4500, 'banana': 4400
      };
      let largePrices = {
        'mussarela': 4900, 'calabresa': 5300, 'marguerita': 5400,
        'portuguesa': 5500, 'frango': 5200, 'lavras': 5400,
        'lombo': 5500, 'quatro': 5500, 'rucula': 5300,
        'romeu': 5500, 'chocolate': 5400, 'banana': 5200
      };

      return size == 'broto'
        ? brotoPrices.get(flavorId, -1)
        : (size == 'media'
          ? mediumPrices.get(flavorId, -1)
          : largePrices.get(flavorId, -1));
    }

    function validFlavors(flavors) {
      return flavors is list
        && ((flavors.size() == 1 && validFlavorId(flavors[0]))
          || (flavors.size() == 2
            && validFlavorId(flavors[0])
            && validFlavorId(flavors[1])
            && flavors[0] != flavors[1]));
    }

    function validItemPrice(item) {
      let firstPrice = priceFor(item.flavors[0], item.size);
      let secondPrice = item.flavors.size() == 2
        ? priceFor(item.flavors[1], item.size)
        : -1;

      // In half-and-half pizzas, the higher priced flavor is charged.
      return item.unitPriceCents
        == (firstPrice > secondPrice ? firstPrice : secondPrice);
    }

    function validPizzaItem(item) {
      return hasAllowedFields(item, ['kind', 'size', 'flavors', 'unitPriceCents'], [])
        && item.kind == 'pizza'
        && item.size is string
        && item.size in ['broto', 'media', 'grande']
        && validFlavors(item.flavors)
        && item.unitPriceCents is int
        && validItemPrice(item);
    }

    function validExtraItem(item) {
      return hasAllowedFields(item, ['kind', 'id', 'name', 'category', 'unitPriceCents'], [])
        && item.kind == 'extra'
        && item.id is string
        && item.name is string
        && item.category is string
        && item.unitPriceCents is int
        && (
          (item.id == 'coca-lata' && item.name == 'Coca-Cola lata' && item.category == 'refrigerantes' && item.unitPriceCents == 700)
          || (item.id == 'guarana-lata' && item.name == 'Guaraná Antarctica lata' && item.category == 'refrigerantes' && item.unitPriceCents == 650)
          || (item.id == 'coca-zero-lata' && item.name == 'Coca-Cola Zero lata' && item.category == 'refrigerantes' && item.unitPriceCents == 700)
          || (item.id == 'sprite-lata' && item.name == 'Sprite lata' && item.category == 'refrigerantes' && item.unitPriceCents == 700)
          || (item.id == 'suco-maracuja' && item.name == 'Del Valle maracujá' && item.category == 'sucos' && item.unitPriceCents == 800)
          || (item.id == 'suco-uva' && item.name == 'Del Valle uva' && item.category == 'sucos' && item.unitPriceCents == 800)
          || (item.id == 'suco-laranja' && item.name == 'Del Valle laranja' && item.category == 'sucos' && item.unitPriceCents == 800)
          || (item.id == 'suco-pessego' && item.name == 'Del Valle pêssego' && item.category == 'sucos' && item.unitPriceCents == 800)
          || (item.id == 'fritas-p' && item.name == 'Batata frita crocante' && item.category == 'batatas' && item.unitPriceCents == 1200)
          || (item.id == 'fritas-cheddar' && item.name == 'Batata cheddar & bacon' && item.category == 'batatas' && item.unitPriceCents == 1600)
        );
    }

    function validItem(item) {
      return validPizzaItem(item) || validExtraItem(item);
    }

    function validItems(items) {
      return items is list
        && ((items.size() == 1 && validItem(items[0]))
          || (items.size() == 2 && validItem(items[0]) && validItem(items[1]))
          || (items.size() == 3 && validItem(items[0]) && validItem(items[1]) && validItem(items[2]))
          || (items.size() == 4 && validItem(items[0]) && validItem(items[1]) && validItem(items[2]) && validItem(items[3]))
          || (items.size() == 5 && validItem(items[0]) && validItem(items[1]) && validItem(items[2]) && validItem(items[3]) && validItem(items[4]))
          || (items.size() == 6 && validItem(items[0]) && validItem(items[1]) && validItem(items[2]) && validItem(items[3]) && validItem(items[4]) && validItem(items[5])));
    }

    function subtotalMatchesItems(items, subtotalCents) {
      return (items.size() == 1 && subtotalCents == items[0].unitPriceCents)
        || (items.size() == 2 && subtotalCents == items[0].unitPriceCents + items[1].unitPriceCents)
        || (items.size() == 3 && subtotalCents == items[0].unitPriceCents + items[1].unitPriceCents + items[2].unitPriceCents)
        || (items.size() == 4 && subtotalCents == items[0].unitPriceCents + items[1].unitPriceCents + items[2].unitPriceCents + items[3].unitPriceCents)
        || (items.size() == 5 && subtotalCents == items[0].unitPriceCents + items[1].unitPriceCents + items[2].unitPriceCents + items[3].unitPriceCents + items[4].unitPriceCents)
        || (items.size() == 6 && subtotalCents == items[0].unitPriceCents + items[1].unitPriceCents + items[2].unitPriceCents + items[3].unitPriceCents + items[4].unitPriceCents + items[5].unitPriceCents);
    }

    function validPayment(route, method) {
      return (route == 'online' && method in ['pix', 'card'])
        || (route == 'whatsapp' && method == 'whatsapp');
    }

    function allowedStatus(status) {
      return status is string
        && status in [
          'new', 'confirmed', 'preparing', 'out_for_delivery', 'delivered', 'cancelled'
        ];
    }

    function validNewOrder(order) {
      return hasAllowedFields(
          order,
          ['customerUid', 'customerEmail', 'customer', 'items',
           'subtotalCents', 'deliveryFeeCents', 'totalCents', 'fulfillmentMethod',
           'checkoutRoute', 'paymentMethod', 'status', 'createdAt', 'updatedAt'],
          ['delivery']
        )
        && validOrderIdentity(order)
        && validCustomer(order.customer)
        && validItems(order.items)
        && order.subtotalCents is int
        && order.subtotalCents >= 650
        && order.subtotalCents <= 50000
        && subtotalMatchesItems(order.items, order.subtotalCents)
        && order.deliveryFeeCents is int
        && order.fulfillmentMethod is string
        && validFulfillment(order)
        && order.totalCents is int
        && order.totalCents == order.subtotalCents + order.deliveryFeeCents
        && order.checkoutRoute is string
        && order.paymentMethod is string
        && validPayment(order.checkoutRoute, order.paymentMethod)
        && order.status == 'new'
        // serverTimestamp() is evaluated as request.time by Firestore Rules.
        && order.createdAt is timestamp
        && order.createdAt == request.time
        && order.updatedAt is timestamp
        && order.updatedAt == request.time;
    }

    function validAdminStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && allowedStatus(request.resource.data.status)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    match /orders/{orderId} {
      // A regular account or a temporary anonymous Firebase session can create
      // a validated order. The browser cannot choose a different UID or email.
      allow create: if canCreateOrder()
        && validNewOrder(request.resource.data);

      // Order details remain private: only the verified owner account can read
      // or list them in the administrative dashboard.
      allow get, list: if isAdmin();

      // Only the verified owner can change workflow fields, never customer,
      // payment, prices, or order line items.
      allow update: if isAdmin() && validAdminStatusUpdate();
      allow delete: if false;
    }

    // Everything else remains private, including the old orderRequests collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
